# ==============================================================================
# PikVaidya AI — Production Environment Configuration Template
# ==============================================================================
# Rename this file to .env.production or export these variables in your deployment

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="PikVaidya AI"
VERSION=1.0.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Security & Cryptography (Generate a cryptographically secure 32+ character key)
SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://pikvaidya_user:pikvaidya_secret@postgres:5432/pikvaidya_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS Whitelist (JSON array of allowed origins)
CORS_ORIGINS=["https://pikvaidya.yourdomain.com", "http://localhost:8000"]

# File Storage Configuration
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Model Paths & Inference Settings
DEVICE=cpu
MODEL_CACHE_DIR=/app/models
SUGARCANE_MODEL_PATH=/app/models/sugarcane/efficientnet_b0/pipeline_trained/best_model.pth
TOMATO_MODEL_PATH=/app/models/tomato/mobilenet_v3/best_model.pth

# External Microclimate API (Open-Meteo is public and requires no key)
WEATHER_API_TIMEOUT=5.0

